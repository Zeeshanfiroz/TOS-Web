# Frontend environment variables
# Copy this file to .env and adjust as needed.
# Leave VITE_API_URL empty for development (Vite proxies /api to localhost:5000).

# ⚠️ Local dev / live backend test setup
# This app is pointed to the deployed Render backend so local frontend reads
# the same database and admin updates as production.
VITE_API_URL=https://tos-web-api.onrender.com/api