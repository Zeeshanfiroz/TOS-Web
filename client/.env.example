# Frontend environment variables
# Copy this file to .env and adjust as needed.
# Leave VITE_API_URL empty for development (Vite proxies /api to localhost:5000).

# ⚠️ ON VERCEL: LEAVE THIS EMPTY (or set to exactly "/api").
# vercel.json already rewrites /api/* to the Render backend — cookies stay
# first-party (same-origin) and login works. If you set VITE_API_URL to the
# full Render URL, login cookies get dropped by browsers (third-party cookie
# blocking) and users appear logged out immediately after login.
# Only set a full URL here for non-Vercel deployments that have no proxy.
VITE_API_URL=