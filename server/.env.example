PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

MONGO_URI=mongodb+srv://<username>:<password>@<cluster-host>/clubdb
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/<imagekit-id>
IMAGEKIT_PUBLIC_KEY=public_<your-public-key>
IMAGEKIT_PRIVATE_KEY=private_<your-private-key>

# Brevo HTTP API (v3) — Brevo → SMTP & API → "API Access Keys" → Generate new key
# (xkeysib-... se shuru hoti hai)
BREVO_API_KEY=your-brevo-api-key
# Sender must be a verified sender in Brevo (Senders & IP)
EMAIL_FROM="TOS Club VSSUT <verified-sender@example.com>"